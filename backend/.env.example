# Port for the Express API server
PORT=5000

# Set to "production" when deploying
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tasklist?retryWrites=true&w=majority

# Frontend URL allowed by CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173
